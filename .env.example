# ── VPS ──────────────────────────────────────────────────────────────────────
VPS_HOST=187.127.213.243
VPS_SSH_KEY=~/.ssh/pf-nfac-hostinger
VPS_ID=1866850

# ── n8n (BEXT stack) ─────────────────────────────────────────────────────────
N8N_URL=https://bext-n8n.srv1866850.hstgr.cloud
N8N_API_URL=https://bext-n8n.srv1866850.hstgr.cloud/api/v1
N8N_API_KEY=
# Generated once with `openssl rand -hex 32`. BACK THIS UP — losing it makes
# every stored n8n credential permanently unreadable.
N8N_ENCRYPTION_KEY=

# ── PostgreSQL (application database) ────────────────────────────────────────
# Loopback-only on the VPS. Local dev reaches it through an SSH tunnel:
#   ssh -i $VPS_SSH_KEY -L 5433:127.0.0.1:5432 root@$VPS_HOST -N
PG_HOST=127.0.0.1
PG_PORT=5433
PG_DB=bext
PG_USER=bext
PG_PASSWORD=

# ── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# ── Microsoft Graph (M365 Developer Sandbox) ─────────────────────────────────
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Mailbox the 05:00 report is sent FROM (must exist in the sandbox tenant)
MS_SENDER_UPN=

# Calendars polled for meetings with transcripts, comma separated. Whoever hosts
# a meeting owns its transcript, so every likely host belongs here. Each one also
# needs the Teams application access policy — graph/teams-access-policy.ps1.
MEETING_HOSTS=

# ── Teams channel announcement ───────────────────────────────────────────────
# Webhook URL from the Teams Workflows flow — no Graph application permission can
# post a channel message. Treat as a secret: the URL is its own bearer token.
# Setup: docs/TEAMS-WEBHOOK-SETUP.md · admin prerequisites: docs/BRENT-TEAMS-ADMIN.md

TEAMS_MEETING_WEBHOOK_URL=

# Header Auth credential in n8n, named "BEXT Webhook Auth", guarding the
# BEXT — Teams Inbound webhook. Unlike the polling workflows that endpoint is
# publicly reachable through traefik, so it needs a real secret. Without this id
# the build skips the workflow rather than publishing it unauthenticated.
N8N_WEBHOOK_CREDENTIAL_ID=

# The shared secret that credential holds. n8n stores its own copy; this is here
# so the Power Automate flow calling the webhook can send the matching header.
# Header name is X-BEXT-Token.
BEXT_WEBHOOK_TOKEN=

# ── AI ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Report delivery ──────────────────────────────────────────────────────────
REPORT_RECIPIENT=
REPORT_TIMEZONE=Australia/Melbourne

# Relevance floor for the daily sheet, 0-100. The scorer was always right; before
# 19 Aug 2026 the report simply did not use it and published 92 items including a
# tobacco bill scoring 0. Everything the client flagged scored 20 or less and
# everything useful scored 55 or more, so 50 sits in the gap. Raise it if the
# sheet still reads long, lower it if something useful is being missed.
REPORT_MIN_RELEVANCE=50

# Per-section backstop against an abnormal day. Not a way of shortening the
# sheet — the relevance floor does that. At 12 it silently dropped six relevant
# articles on 20 August, so it is deliberately set well above normal volume.
REPORT_MAX_PER_SECTION=40
N8N_PG_CREDENTIAL_ID=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
REPORT_SENDER=

N8N_OLLAMA_CREDENTIAL_ID=

# Teams Workflows webhook for the "Daily report" channel, on the same team as
# Bext Transcripts. A SEPARATE flow and a SEPARATE secret from the meeting one —
# create-channel-flow.js used to write every flow it read into the meeting
# variable, which silently repointed meeting announcements at this channel.
TEAMS_DAILY_WEBHOOK_URL=

# The Daily report channel folder in the team document library. Not a secret —
# reaching it still needs the Graph client credentials.
TEAMS_DAILY_DRIVE_ID=
