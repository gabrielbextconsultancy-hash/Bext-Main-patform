        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "N8N_API_URL": "https://bext-n8n.srv1866850.hstgr.cloud",
        "N8N_API_KEY": "${BEXT_N8N_API_KEY}"
      }
    },
    "teams": {
      "command": "npx",
      "args": ["-y", "@floriscornel/teams-mcp@0.9.0"],
      "env": {}
    },
    "flowagent": {
